#!/command/with-contenv sh
# Reverb Finish Script
# Graceful shutdown handler for Reverb WebSocket server

echo "[reverb] Reverb WebSocket server stopped with exit code: $1"

if [ "$1" -ne 0 ]; then
    echo "[reverb] Reverb exited with error, container will restart"
fi

exit 0
#!/command/with-contenv sh
# Queue Worker Service
# Runs Laravel queue worker with graceful shutdown support

set -e

echo "[queue] Starting Laravel Queue Worker..."

cd /var/www/html

# Run queue worker with proper signal handling
exec s6-setuidgid www-data \
    php artisan queue:work \
        --tries=3 \
        --timeout=90 \
        --sleep=3 \
        --max-jobs=1000 \
        --memory=256 \
        --verbose

